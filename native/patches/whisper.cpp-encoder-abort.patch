+
     const bool t = (ggml_backend_sched_graph_compute(sched, graph) == GGML_STATUS_SUCCESS);
 
+    if (abort_callback) {
+        // the callback's data lives only as long as the caller's whisper_full
+        czechspeech_set_abort_callback(sched, nullptr, nullptr);
+    }
+
     if (!t || sched_reset) {
         ggml_backend_sched_reset(sched);
     }
